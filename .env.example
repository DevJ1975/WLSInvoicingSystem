# Firebase web config (Project settings -> General -> Your apps -> SDK setup).
# EXPO_PUBLIC_ vars are embedded in the client bundle at build time.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# Optional (Google Analytics, web only); leave blank to disable
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Base URL of deployed Cloud Functions (e.g. https://us-central1-<project>.cloudfunctions.net)
# Enables in-app email + public share links. Leave blank to disable.
EXPO_PUBLIC_FUNCTIONS_BASE_URL=

# Public web app origin used to build shareable links (your Vercel URL).
EXPO_PUBLIC_WEB_BASE_URL=

# Optional: Mapbox access token to auto-calculate driving distance for manual mileage entries.
EXPO_PUBLIC_MAPBOX_TOKEN=
