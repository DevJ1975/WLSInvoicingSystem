# Firebase Web App config (Project settings -> General -> Your apps -> SDK setup)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional (Google Analytics); leave blank to disable
VITE_FIREBASE_MEASUREMENT_ID=

# Base URL of the deployed Cloud Functions (e.g. https://us-central1-<project>.cloudfunctions.net)
# Used for the email + public share endpoints. Leave blank to disable in-app email.
VITE_FUNCTIONS_BASE_URL=

# Optional: Mapbox access token to auto-calculate driving distance for manual mileage entries.
# Leave blank to enter miles manually.
VITE_MAPBOX_TOKEN=
