# Copy to functions/.env and fill in.
# RESEND_API_KEY is a SECRET — set it with:  firebase functions:secrets:set RESEND_API_KEY
# (do NOT put the API key in this file)

# Verified Resend sender. For quick testing you can use onboarding@resend.dev.
RESEND_FROM="WLS Invoicing <invoices@yourdomain.com>"

# Restrict CORS to your deployed frontend origin (or * during development).
ALLOWED_ORIGIN="https://your-app.vercel.app"
