rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // All of a user's data lives under /users/{uid}/...
    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /{document=**} {
        allow read, write: if isOwner(uid);
      }
    }

    // Share lookup docs: an owner may create/delete their own share tokens.
    // Reads happen server-side via the Admin SDK (shareReport function), so
    // clients never need read access here.
    match /shares/{token} {
      allow create, delete: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid;
      allow read: if false;
    }
  }
}
